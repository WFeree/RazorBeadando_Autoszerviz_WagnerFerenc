@page
@model RazorBeadando_Autoszerviz_WagnerFerenc.Pages.JavitasPages.IndexModel
<h2>Javítások</h2>
<a asp-page="Create" class="btn btn-primary mb-2">Új javítás</a>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="form-select w-auto">
        <option value="">-- All --</option>
    </select>
    <button class="btn btn-secondary">Szűrő</button>
</form>

<table class="table">
    <tr><th>Ügyfél</th><th>Rendszám</th><th>Leírás</th><th>Költség</th><th>Állapot</th><th>Felvétel dátuma</th><th></th></tr>
    @foreach (var s in Model.Javitasok)
    {
        <tr>
            <td>@s.Ugyfel?.Nev</td>
            <td>@s.Rendszam</td>
            <td>@s.Leiras</td>
            <td>@s.Koltseg.ToString("N2")</td>
            <td>@s.Allapot</td>
            <td>@s.Hozzaadva.ToShortDateString()</td>
            <td>
                <a asp-page="Edit" asp-route-id="@s.Id">Edit</a>
                @if (s.Allapot != Models.Allapot.Kész)
                {
                    <form method="post" asp-page-handler="Advance" asp-route-id="@s.Id"
                          asp-route-StatusFilter="@Model.StatusFilter" class="d-inline">
                        <button class="btn btn-sm btn-outline-success">
                            @(s.Allapot == Models.Allapot.Felvéve ? "Elindítani" : "Befejezni")
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
</table>