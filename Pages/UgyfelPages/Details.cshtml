@page "{id:int}"
@model RazorBeadando_Autoszerviz_WagnerFerenc.Pages.UgyfelPages.DetailsModel
<h2>@Model.Ugyfel.Nev</h2>
<p>@Model.Ugyfel.Telefonszam | @Model.Ugyfel.Email</p>
<table class="table">
    <tr><th>Plate</th><th>Description</th><th>Status</th><th>Date</th><th>Price</th></tr>
    @foreach (var s in Model.Ugyfel.Javitasok.OrderByDescending(s => s.Hozzaadva))
    {
        <tr>
            <td>@s.Rendszam</td>
            <td>@s.Leiras</td>
            <td>@s.Allapot</td>
            <td>@s.Hozzaadva.ToShortDateString()</td>
            <td>@s.Koltseg.ToString("N2")</td>
        </tr>
    }
    <tr class="fw-bold"><td colspan="4">Total</td><td>@Model.SumPrice.ToString("N2")</td></tr>
</table>
<a asp-page="Index">Back</a>