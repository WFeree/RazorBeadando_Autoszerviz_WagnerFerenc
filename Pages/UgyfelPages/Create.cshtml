@page
@model RazorBeadando_Autoszerviz_WagnerFerenc.Pages.UgyfelPages.CreateModel
<h2>Új Ügyfel</h2>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="Ugyfel.Nev"></label>
        <input asp-for="Ugyfel.Nev" class="form-control" />
        <span asp-validation-for="Ugyfel.Nev" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Ugyfel.Telefonszam"></label>
        <input asp-for="Ugyfel.Telefonszam" class="form-control" />
        <span asp-validation-for="Ugyfel.Telefonszam" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Ugyfel.Email"></label>
        <input asp-for="Ugyfel.Email" class="form-control" />
        <span asp-validation-for="Ugyfel.Email" class="text-danger"></span>
    </div>
    <button class="btn btn-success">Mentés</button>
    <a asp-page="Index">Vissza</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}