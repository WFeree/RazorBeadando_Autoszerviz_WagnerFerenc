@page
@model RazorBeadando_Autoszerviz_WagnerFerenc.Pages.UgyfelPages.IndexModel
<h2>Ügyfelek</h2>
<a asp-page="Create" class="btn btn-primary mb-2">Ügyfél hozzáadása</a>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<table class="table">
    <tr><th>Név</th><th>Telefonszám</th><th>Email</th><th></th></tr>
    @foreach (var c in Model.Ugyfelek)
    {
        <tr>
            <td>@c.Nev</td>
            <td>@c.Telefonszam</td>
            <td>@c.Email</td>
            <td>
                <a asp-page="Details" asp-route-id="@c.Id">Részletek</a> |
                <a asp-page="Edit" asp-route-id="@c.Id">Szerkesztés</a> |
                <a asp-page="Delete" asp-route-id="@c.Id">Törlés</a>
            </td>
        </tr>
    }
</table>